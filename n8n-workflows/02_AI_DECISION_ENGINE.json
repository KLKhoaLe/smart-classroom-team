        "url": "http://host.docker.internal:3001/api/decisions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({telemetry_id:String($json.telemetry_id),room:$json.room,decision_source:$json.decision_source,fan_action:$json.fan_action,light_action:$json.light_action,mode:$json.mode,reason:$json.reason,model_name:$json.model_name ?? null}) }}",
        "options": {
          "timeout": 15000
        }
