    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-6-luna",
          "mode": "list",
          "cachedResultName": "GPT-6-LUNA"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You are the AI decision engine for a Smart Classroom system.\n\nAnalyze classroom sensor data and the existing rule-based decision.\n\nSafety rules must always be respected:\n- If occupancy is false, fan_action must be OFF and light_action must be OFF.\n- If occupancy is true and temperature is above 30°C, fan_action must be ON.\n- If occupancy is true and temperature is 30°C or below, fan_action must be OFF.\n- If occupancy is true and light_percent is below 30, light_action must be ON.\n- If occupancy is true and light_percent is 30 or above, light_action must be OFF.\n\nReturn ONLY valid JSON with exactly these fields:\n\n{\n  \"fan_action\": \"ON or OFF\",\n  \"light_action\": \"ON or OFF\",\n  \"mode\": \"SMART_COMFORT or ENERGY_SAVING\",\n  \"reason\": \"short explanation\"\n}\n\nDo not return markdown.\nDo not return code fences.\nDo not add any fields outside this JSON."
            },
            {
              "content": "=Room: {{ $json.room }}\nTemperature: {{ $json.temperature }} °C\nHumidity: {{ $json.humidity }} %\nOccupancy: {{ $json.occupancy }}\nLight percent: {{ $json.light_percent }} %\n\nCurrent rule decision:\nFan: {{ $json.fan_action }}\nLight: {{ $json.light_action }}\nMode: {{ $json.mode }}\nReason: {{ $json.reason }}\n\nAnalyze this classroom state and return the required JSON decision."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1936,
        48
      ],
      "id": "65e7743f-1cc1-4ed7-bd55-b109f23dd323",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "zlsXIGLI4xBvQScG",
          "name": "OpenAI account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const text =\n  $json.output?.[0]?.content?.find(\n    item => item.type === 'output_text'\n  )?.text;\n\nif (!text) {\n  throw new Error('AI response text not found');\n}\n\nconst cleanedText = text\n  .replace(/```json/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nconst ai = JSON.parse(cleanedText);\n\n// Lấy lại dữ liệu gốc trước khi gọi AI\nconst original = $('Prepare Decision Input').item.json;\n\n// Kiểm tra output AI có hợp lệ không\nconst validActions = ['ON', 'OFF'];\n\nif (!validActions.includes(ai.fan_action)) {\n  throw new Error('Invalid AI fan_action');\n}\n\nif (!validActions.includes(ai.light_action)) {\n  throw new Error('Invalid AI light_action');\n}\n\nif (!ai.mode || !ai.reason) {\n  throw new Error('AI response missing mode or reason');\n}\n\nreturn {\n  json: {\n    ...original,\n\n    fan_action: ai.fan_action,\n    light_action: ai.light_action,\n    mode: ai.mode,\n    reason: ai.reason,\n\n    decision_source: 'AI',\n    model_name: 'GPT-6-LUNA'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2320,
        -16
      ],
      "id": "42c2612e-1b70-4b65-9da8-dbac2ec8b8de",
      "name": "Parse AI Response"
    },
    {
      "parameters": {
        "jsCode": "let ruleDecision = null;\n\n// Trường hợp phòng có người\ntry {\n  ruleDecision = $('Finalize Occupied Decision').item.json;\n} catch (e) {\n  // Node này có thể không chạy nếu phòng trống\n}\n\n// Trường hợp phòng trống\nif (!ruleDecision) {\n  try {\n    ruleDecision = $('Set Empty Room Decision').item.json;\n  } catch (e) {\n    // Node này có thể không chạy nếu phòng có người\n  }\n}\n\nif (!ruleDecision) {\n  throw new Error('Cannot find rule-based decision for fallback');\n}\n\nreturn {\n  json: {\n    ...ruleDecision,\n\n    decision_source: 'RULE',\n    model_name: 'RULE_FALLBACK',\n\n    reason:\n      ruleDecision.reason +\n      '; AI unavailable, using rule-based fallback'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2304,
        144
      ],
      "id": "e33765e1-ad08-48e0-a35c-deb85b3fe910",
      "name": "Use Rule Fallback"
    },
