      "id": "0ec8f931-b2d2-40ca-aef3-d422c17e4c02",
      "name": "Save Decision to Backend"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-6-luna",
          "mode": "list",
          "cachedResultName": "GPT-6-LUNA"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "You review a Smart Classroom rule decision. Return ONLY JSON with fan_action (ON/OFF), light_action (ON/OFF), mode (SMART_COMFORT/ENERGY_SAVING), reason (nonempty string, max 1500 characters). Keep fan_action, light_action and mode EXACTLY as the supplied deterministic rule. Your useful role is to analyze the recent history: mention a temperature/humidity trend only when supported, explain the action and optionally suggest a practical adjustment for human review. Do not invent consumption measurements, savings, faults, or history. Write the reason in Vietnamese. Recommendations are advisory; they do not change device commands."
            },
            {
              "content": "={{ JSON.stringify($json) }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        3264,
        656
      ],
      "id": "296f7716-7ca6-42fd-ba9b-50bbc6e8125b",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "zlsXIGLI4xBvQScG",
          "name": "OpenAI account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rule=$('Capture Rule Decision').first().json;\nconst text=$json.output?.flatMap(o=>o.content ?? []).find(x=>x.type==='output_text')?.text;\nif (typeof text!=='string') throw new Error('AI_TEXT_MISSING');\nconst ai=JSON.parse(text.replace(/^\\s*```(?:json)?\\s*/i,'').replace(/\\s*```\\s*$/,'').trim());\nif (!ai || typeof ai!=='object' || Array.isArray(ai)) throw new Error('AI_OBJECT_REQUIRED');\nif (!['ON','OFF'].includes(ai.fan_action)||!['ON','OFF'].includes(ai.light_action)) throw new Error('AI_ACTION_INVALID');\nif (!['SMART_COMFORT','ENERGY_SAVING'].includes(ai.mode)) throw new Error('AI_MODE_INVALID');\nif(typeof ai.reason!=='string'||!ai.reason.trim()||ai.reason.length>1500) throw new Error('AI_REASON_INVALID');\nif(ai.fan_action!==rule.fan_action||ai.light_action!==rule.light_action||ai.mode!==rule.mode) throw new Error('AI_RULE_VIOLATION');\nreturn {json:{...rule,fan_action:ai.fan_action,light_action:ai.light_action,mode:ai.mode,reason:ai.reason.trim(),decision_source:'AI',model_name:'GPT-6-LUNA'}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
        448
      ],
      "id": "ed8033a2-dad2-4446-ba76-7dbf37a37f7f",
      "name": "Parse AI Response",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rule=$('Capture Rule Decision').first().json;\nreturn {json:{...rule,decision_source:'RULE',model_name:'RULE_FALLBACK',reason:rule.reason+'; AI unavailable or invalid; deterministic rule fallback.'}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3856,
        448
      ],
      "id": "4a98f508-142a-4134-8b61-b98cb3f09333",
      "name": "Use Rule Fallback"
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "ruWXnIqNiq9sRXEl",
          "mode": "list",
          "cachedResultUrl": "/workflow/ruWXnIqNiq9sRXEl",
          "cachedResultName": "03_MASTER_AUTOMATION_V2"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {},
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        4608,
        448
      ],
      "id": "6466b7da-838a-40bd-a007-e72acc39adf8",
      "name": "Run Master Automation"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const decision = $json;\n\n// Dữ liệu sensor gốc trước khi gọi AI\nconst original = $('Prepare Decision Input').item.json;\n\nreturn {\n  json: {\n    decision_id: decision.id,\n\n    telemetry_id:\n      decision.sourceTelemetryId ??\n      original.telemetry_id ??\n      null,\n\n    device_id: original.device_id,\n    room: original.room,\n\n    fan_action: decision.fanAction,\n    light_action: decision.lightAction,\n\n    mode: decision.mode,\n    decision_source: decision.decisionSource,\n    reason: decision.reason,\n\n    model_name: decision.modelName ?? null,\n\n    timestamp:\n      decision.createdAt ??\n      original.timestamp\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4352,
        448
      ],
      "id": "a23d9dfb-6709-404c-989b-9b58e9b1483a",
      "name": "Prepare Master Automation Payload"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {json:{...$json}};"
      },
      "id": "009acfeb-2788-4212-8119-d8de57cace03",
      "name": "Capture Rule Decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2512,
        656
      ]
    },
    {
      "parameters": {
        "url": "={{ 'http://host.docker.internal:3001/api/telemetry/recent?room=' + encodeURIComponent($json.room) + '&limit=10' }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        }
      },
      "id": "3feb4936-d8f6-45da-b219-f85141d0b342",
      "name": "Get Recent Telemetry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2752,
        656
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rule=$('Capture Rule Decision').first().json;\nconst rows=Array.isArray($json.body)?$json.body:[];\nconst history=rows.map(r=>({temperature:Number(r.temperature),humidity:Number(r.humidity),light_percent:Number(r.lightPercent),occupancy:r.occupancy,timestamp:r.receivedAt})).filter(r=>Number.isFinite(r.temperature));\nreturn {json:{...rule,recent_history:history,history_available:history.length>0}};"
      },
      "id": "116b79cb-b726-46b3-8613-ad7299a2ed28",
      "name": "Build AI Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3008,
        656
      ]
    },
    {
      "parameters": {
        "content": "## Setup\nSelect an OpenAI credential and an available model in Message a model. If you change model, change model_name in Parse AI Response too.\nSelect 03_MASTER_AUTOMATION_V2 in Run Master Automation.\nCall this workflow with ONE telemetry per execution (parent node mode = each).\n\n## Behavior\nRule commands remain deterministic. AI now reviews up to 10 recent records and writes a Vietnamese explanation/advisory recommendation. AI does NOT autonomously override thresholds. Explain this honestly in the presentation.\nBoth API errors and invalid AI JSON/actions/mode/reason go to RULE fallback. Invalid actions cannot bypass rules.\nHistory failure permits rule + AI with no history; database write failures still stop execution.\nNo hysteresis yet: requires reliable per-actuator state. WF03 adds cooldown instead.",
        "height": 580,
        "width": 680
      },
      "id": "5b38b461-dce9-4c75-8194-bdf33c3894ee",
      "name": "README - IMPORT AND LIMITS",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    }
  ],
