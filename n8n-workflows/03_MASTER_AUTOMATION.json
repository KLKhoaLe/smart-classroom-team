{
  "name": "03_MASTER_AUTOMATION_V2",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        512,
        656
      ],
      "id": "a9cd48ee-59e4-4081-ba69-d0f25befbca7",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d=$json;\nfor (const key of ['decision_id','device_id','room']) if(typeof d[key]!=='string'||!d[key].trim()) throw new Error('Missing '+key);\nfor (const key of ['fan_action','light_action']) if(!['ON','OFF','KEEP'].includes(d[key])) throw new Error('Invalid '+key);\nreturn {json:{...d,manual_hold_seconds:300,cooldown_seconds:20,pending_timeout_seconds:120,dispatch_enabled:false}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        656
      ],
      "id": "59a93237-08cc-4a76-965c-2ffd46c8cbaf",
      "name": "Prepare Automation Input"
    },
    {
      "parameters": {
        "jsCode": "const d=$input.first().json;\nreturn d.actions.map(a=>({json:{device_id:d.device_id,decision_id:d.decision_id,...a,source:'AUTO',telemetry_id:d.telemetry_id,room:d.room,mode:d.mode,decision_source:d.decision_source,reason:d.reason,dispatch_enabled:d.dispatch_enabled},pairedItem:{item:0}}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2256,
        656
      ],
      "id": "d16f9bf2-ebb5-4064-98ed-eb1f393314a6",
      "name": "Build Device Commands"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3001/api/commands",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({device_id:$json.device_id,decision_id:$json.decision_id,command_type:$json.command_type,action:$json.action,source:$json.source,payload:{device_code:$json.device_id,telemetry_id:$json.telemetry_id,room:$json.room,mode:$json.mode,decision_source:$json.decision_source,reason:$json.reason}}) }}",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        2512,
        656
      ],
      "id": "0df26006-1742-4e47-bcc7-e7bf7805d64f",
      "name": "Create Command in Backend"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d=$json;\nreturn {json:{command_id:d.id,device_id:d.payload.device_code,device_code:d.payload.device_code,device_uuid:d.deviceId,decision_id:d.decisionId,command_type:d.commandType,action:d.action,source:d.source,status:d.status,payload:d.payload,requested_at:d.requestedAt,dispatch_enabled:$('Prepare Automation Input').first().json.dispatch_enabled}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2752,
        656
      ],
      "id": "b47fb3aa-2558-408a-91ae-a44a291e4d11",
      "name": "Prepare Dispatch Payload"
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:3001/api/commands/recent?limit=200",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        }
      },
      "id": "62adf32a-bc89-4ef2-ab00-25449d2fbbff",
      "name": "Get Recent Commands",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1008,
        656
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d=$('Prepare Automation Input').first().json;\nif(!Array.isArray($json.body)) throw new Error('Recent commands response must be an array');\nconst rows=$json.body;\n// deviceId is a UUID; current decisions use ESP32_A101. Query identity from the original telemetry's room dashboard next.\nreturn {json:{...d,recent_commands:rows}};"
      },
      "id": "0e72557e-ec94-4a48-8f46-901b647e52b8",
      "name": "Evaluate Automation Guards",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1264,
        656
      ]
    },
    {
      "parameters": {
        "url": "={{ 'http://host.docker.internal:3001/api/dashboard/rooms/' + encodeURIComponent($json.room) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          },
          "timeout": 10000
        }
      },
      "id": "04292d91-c92a-4be8-9ddc-8c4061ad796b",
      "name": "Get Room Devices",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1504,
        656
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d=$('Evaluate Automation Guards').first().json;\nconst dev=$json.body?.devices?.find(x=>x.deviceCode===d.device_id);\nif(!dev) throw new Error('Device not found in room dashboard: '+d.device_id);\nconst now=Date.now();const logs=[];const actions=[];\nconst records=d.recent_commands.filter(x=>x.deviceId===dev.id).sort((a,b)=>Date.parse(b.requestedAt)-Date.parse(a.requestedAt));\nfor(const [type,action] of [['FAN',d.fan_action],['LIGHT',d.light_action]]){\n if(action==='KEEP'){logs.push(type+':KEEP');continue;}\n const rows=records.filter(r=>r.commandType===type);\n const age=r=>(now-Date.parse(r.requestedAt))/1000;\n const latest=rows[0];\n if(rows.some(r=>r.source==='MANUAL'&&['PENDING','SENT','ACK'].includes(r.status)&&age(r)>=0&&age(r)<d.manual_hold_seconds)){logs.push(type+':MANUAL_HOLD');continue;}\n const pending=rows.find(r=>['PENDING','SENT'].includes(r.status));\n if(pending){logs.push(type+':'+(age(pending)>d.pending_timeout_seconds?'PENDING_TIMEOUT_REQUIRES_REVIEW':'COMMAND_IN_FLIGHT'));continue;}\n if(latest?.status==='ACK'&&latest.action===action){logs.push(type+':ALREADY_ACKNOWLEDGED');continue;}\n if(latest&&age(latest)>=0&&age(latest)<d.cooldown_seconds){logs.push(type+':COOLDOWN');continue;}\n actions.push({command_type:type,action});\n}\nreturn {json:{...d,device_uuid:dev.id,actions,guard_reasons:logs,has_actions:actions.length>0}};"
      },
      "id": "21d9d439-749b-47be-9e4c-f7810bb64df2",
      "name": "Filter Required Actions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        656
      ]
    },
    {
      "parameters": {
        "conditions": {
