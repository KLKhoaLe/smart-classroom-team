        "jsCode": "const d=$json;\nconst num=x=>typeof x==='number' && Number.isFinite(x)?x:null;\n// Current backend rejects wrong types. Preserve the raw packet in error_reason (max 6000 chars).\nreturn {json:{device_id:typeof d.device_id==='string'?d.device_id:null,room:typeof d.room==='string'?d.room:null,\n temperature:num(d.temperature),humidity:num(d.humidity),occupancy:typeof d.occupancy==='boolean'?d.occupancy:null,\n light_raw:Number.isInteger(d.light_raw)?d.light_raw:null,\n error_reason:String(d.error_reason ?? 'INVALID_SENSOR_DATA')+' | raw='+String(d.raw_message ?? '').slice(0,6000),timestamp:d.timestamp}};"
