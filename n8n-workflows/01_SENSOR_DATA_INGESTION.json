        "jsCode": "const raw = $json.message;\nlet data = {}; let error = null;\ntry {\n data = typeof raw === 'string' ? JSON.parse(raw) : raw;\n if (!data || typeof data !== 'object' || Array.isArray(data)) throw new Error('Expected object');\n} catch(e) { data = {}; error = 'INVALID_JSON'; }\nif (!error) {\n if (typeof data.device_id !== 'string' || data.device_id !== 'ESP32_A101') error='INVALID_DEVICE_ID';\n else if (data.room !== 'A101') error='INVALID_ROOM';\n else if (typeof data.temperature !== 'number' || !Number.isFinite(data.temperature)) error='INVALID_TEMPERATURE_TYPE';\n else if (typeof data.humidity !== 'number' || !Number.isFinite(data.humidity)) error='INVALID_HUMIDITY_TYPE';\n else if (typeof data.occupancy !== 'boolean') error='INVALID_OCCUPANCY_TYPE';\n else if (!Number.isInteger(data.light_raw)) error='INVALID_LIGHT_TYPE';\n}\nreturn {json:{...data, topic:$json.topic ?? null, raw_message:typeof raw==='string'?raw:JSON.stringify(raw ?? null), parse_ok:!error, error_reason:error}};"
      },
