    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $('Normalize and Validate Incident').first().json;\nconst normalize = value => String(value ?? '').trim().toLowerCase().replace(/\\s+/g, ' ');\nconst candidates = $input.all().flatMap(item => Array.isArray(item.json) ? item.json : [item.json]);\nconst duplicate = candidates.find(item => item.id && item.status === 'OPEN' && normalize(item.incidentType) === normalize(payload.incident_type) && normalize(item.message) === normalize(payload.message));\nreturn [{ json: { ...payload, duplicate_id: duplicate?.id ?? null } }];"
      },
