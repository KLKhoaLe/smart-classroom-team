    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $json.body && typeof $json.body === 'object' ? $json.body : $json;\nconst action = String(input.action ?? 'CREATE').toUpperCase();\nconst allowedSeverities = ['INFO', 'LOW', 'WARNING', 'MEDIUM', 'HIGH', 'CRITICAL'];\nif (!['CREATE', 'RESOLVE', 'UPDATE_STATUS'].includes(action)) throw new Error('Unsupported incident action');\n\nif (action === 'RESOLVE') {\n  if (!input.incident_id) throw new Error('incident_id is required to resolve an incident');\n  return { json: { action, incident_id: String(input.incident_id) } };\n}\n\nif (action === 'UPDATE_STATUS') {\n  if (!input.incident_id) throw new Error('incident_id is required to update status');\n  if (!['OPEN', 'RESOLVED'].includes(input.status)) throw new Error('status must be OPEN or RESOLVED');\n  if (input.severity && !allowedSeverities.includes(String(input.severity).toUpperCase())) throw new Error('Unsupported incident severity');\n  if (input.message !== undefined && String(input.message).trim().length < 3) throw new Error('message must contain at least 3 characters');\n  return { json: { action, incident_id: String(input.incident_id), status: input.status, severity: input.severity, message: input.message } };\n}\n\nconst room = String(input.room ?? '').trim();\nconst incident_type = String(input.incident_type ?? '').trim();\nconst severity = String(input.severity ?? '').toUpperCase();\nconst message = String(input.message ?? '').trim();\nif (!room || !incident_type || message.length < 3) throw new Error('room, incident_type and a message of at least 3 characters are required');\nif (!allowedSeverities.includes(severity)) throw new Error('Unsupported incident severity');\nreturn { json: { action: 'CREATE', room, device_id: input.device_id ?? undefined, telemetry_id: input.telemetry_id ?? undefined, incident_type, severity, message } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0],
